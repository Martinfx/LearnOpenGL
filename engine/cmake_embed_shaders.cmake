# Generates a C++ source with every shader in engine/shaders/ as a string, so the
# game ships without loose shader files. The editor can still load edited copies
# from disk at runtime (Renderer::reloadShaders).
file(GLOB ENGINE_SHADER_FILES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.glsl"
     "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.vert" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.frag")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ENGINE_SHADER_FILES})
set(ENGINE_SHADER_ENTRIES "")
foreach(shader ${ENGINE_SHADER_FILES})
    file(READ "${shader}" source)
    get_filename_component(name "${shader}" NAME)
    string(APPEND ENGINE_SHADER_ENTRIES "    {\"${name}\", R\"GLSL(${source})GLSL\"},\n")
endforeach()
set(ENGINE_EMBEDDED_SHADERS "${CMAKE_CURRENT_BINARY_DIR}/generated/EmbeddedShaders.cpp")
file(CONFIGURE OUTPUT "${ENGINE_EMBEDDED_SHADERS}" CONTENT
"// Generated by engine/cmake_embed_shaders.cmake from engine/shaders/. Do not edit.
#include <map>
#include <string>

namespace engine {
const std::map<std::string, std::string>& embeddedShaders()
{
    static const std::map<std::string, std::string> shaders = {
@ENGINE_SHADER_ENTRIES@    };
    return shaders;
}
} // namespace engine
" @ONLY)
