#version 450 core
// Volumetric fog, step 1: the light scattered toward the eye and the fog density in every
// froxel (a cell of the view frustum: screen tiles x exponential depth slices). Sun light
// through the cascaded shadow map gives light shafts; local lights (lamps, the flashlight)
// come from the light clusters. The result is blended with the previous frame (reprojected),
// which smooths the per-frame depth jitter.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "common.glsl"
#include "lights.glsl"
layout(binding = 6) uniform sampler2DArrayShadow uShadowMap;
layout(binding = 0) uniform sampler3D uHistory;
layout(rgba16f, binding = 0) writeonly uniform image3D uOut;
uniform ivec3 uDims;
uniform float uJitter;          // -0.5 .. 0.5 slice offset of this frame
uniform mat4 uInvView;
uniform mat4 uPrevViewProj;
uniform bool uHistoryValid;
uniform float uHistoryWeight;
uniform vec4 uVolumeLight;      // x: light shafts, y: anisotropy, z: noise, w: local lights

float sliceDepth(float z) { return uVolumetric.y * exp(z / uVolumetric.z); }

float phaseHG(float cosTheta, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * cosTheta, 1e-4), 1.5));
}

// One tap of the cascaded shadow map (the fog is soft anyway).
float fogSunShadow(vec3 worldPos, float viewDepth) {
    if (uSunColor.w < 0.5)
        return 1.0;
    int count = int(uCascadeSplits.w);
    if (viewDepth > uCascadeSplits[count - 1])
        return 1.0;
    int cascade = count - 1;
    for (int i = 0; i < count; ++i)
        if (viewDepth < uCascadeSplits[i]) { cascade = i; break; }
    vec4 p = uShadowMatrices[cascade] * vec4(worldPos, 1.0);
    vec3 c = p.xyz / p.w * 0.5 + 0.5;
    if (c.z >= 1.0)
        return 1.0;
    float shadow = texture(uShadowMap, vec4(c.xy, float(cascade), c.z - uShadowParams.x * (1.0 + float(cascade))));
    float fade = smoothstep(uCascadeSplits[count - 1] * 0.85, uCascadeSplits[count - 1], viewDepth);
    return mix(shadow, 1.0, fade);
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(cell, uDims)))
        return;
    vec2 uv = (vec2(cell.xy) + 0.5) / vec2(uDims.xy);
    float depth = sliceDepth((float(cell.z) + 0.5 + uJitter) / float(uDims.z));
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 viewPos = vec3((ndc.x + uProj[2][0]) / uProj[0][0], (ndc.y + uProj[2][1]) / uProj[1][1], -1.0) * depth;
    vec3 worldPos = (uInvView * vec4(viewPos, 1.0)).xyz;
    vec3 dir = normalize(worldPos - uCameraPos.xyz);

    // Density: the height fog of the level, broken up by noise drifting with the wind.
    float falloff = max(uFogParams.y, 1e-4);
    float density = min(uFogColor.w * exp(min(-falloff * (worldPos.y - uFogParams.x), 8.0)), 1.0);
    if (uVolumeLight.z > 0.0) {
        vec2 drift = uWind.xz * uSkyHorizon.w * (0.3 + 2.0 * uWind.y);
        float n = 0.5 * (valueNoise(worldPos.xz * 0.09 - drift * 0.09) + valueNoise(vec2(worldPos.x + worldPos.z, worldPos.y) * 0.13 + drift.yx * 0.05));
        n = n * 0.7 + 0.3 * valueNoise(worldPos.xz * 0.31 + worldPos.y * 0.2 - drift * 0.2);
        density *= mix(1.0, n * 2.0, clamp(uVolumeLight.z, 0.0, 1.0));
    }

    // Light: the fog colour as ambient (darker in shadow when there are shafts), the sun through
    // the shadow map and the local lights, all with a forward-scattering phase function.
    float g = clamp(uVolumeLight.y, -0.9, 0.9);
    float shadow = fogSunShadow(worldPos, depth);
    float cosSun = dot(dir, -normalize(uSunDir.xyz));
    float shafts = max(uVolumeLight.x, 0.0);
    vec3 light = uFogColor.rgb * mix(1.0, shadow, clamp(shafts * 0.25, 0.0, 0.5));
    light += vec3(0.5, 0.55, 0.7) * uWeather.y * 0.12;
    light += uSunColor.rgb * uSunDir.w * shadow * (0.08 * pow(max(cosSun, 0.0), 8.0) * uFogParams.z + shafts * phaseHG(cosSun, g) * 0.6);
    if (uClusterDims.w > 0 && uVolumeLight.w > 0.0) {
        uvec2 cluster = lightCluster(uv, depth);
        for (uint i = 0u; i < cluster.y; ++i) {
            LocalLight l = uLights[uLightIndices[cluster.x + i]];
            vec3 toLight = l.posRange.xyz - worldPos;
            float d2 = dot(toLight, toLight);
            float r2 = l.posRange.w * l.posRange.w;
            if (d2 >= r2)
                continue;
            float dist = sqrt(d2);
            vec3 ld = toLight / max(dist, 1e-4);
            float window = clamp(1.0 - (d2 / r2) * (d2 / r2), 0.0, 1.0);
            float atten = window * window / (d2 + 1.0);
            if (l.colorType.w > 0.5) {
                float cd = dot(-ld, l.dirShadow.xyz);
                float cone = clamp((cd - l.cone.x) * l.cone.y, 0.0, 1.0);
                atten *= cone * cone;
                if (l.cone.w > 0.5)
                    atten *= flashlightCookie(l, cd);
            }
            if (atten <= 0.0)
                continue;
            if (l.dirShadow.w >= 0.0)
                atten *= localShadow(l, worldPos, vec3(0.0), dist);
            light += l.colorType.rgb * atten * phaseHG(dot(ld, dir), g * 0.5) * uVolumeLight.w;
        }
    }

    vec4 result = vec4(light, density);
    if (uHistoryValid) {
        vec4 prev = uPrevViewProj * vec4(worldPos, 1.0);
        if (prev.w > 1e-3) {
            vec3 p = vec3(prev.xy / prev.w * 0.5 + 0.5, log(max(prev.w, uVolumetric.y) / uVolumetric.y) * uVolumetric.z);
            if (all(greaterThanEqual(p, vec3(0.0))) && all(lessThanEqual(p, vec3(1.0))))
                result = mix(result, texture(uHistory, p), uHistoryWeight);
        }
    }
    imageStore(uOut, cell, result);
}
