# ---------------------------------------------------------------- organic layout (shape grammar, engine/CityGrammar.h)
# Texture sets of the generated houses.
textures "../models/zone/textures"
# style "name" role <tenement|panel|khrushchyovka|house> ... (grammar materials: see the editor's Kit tab)
style "Brick tenement" role tenement floors_min 4 floors_max 6 ground 4 storey 3.3 bay 3.4 window_w 1.3 window_h 1.9 sill 0.9 depth_min 12 depth_max 14 width_min 14 width_max 28 wall brick_red plinth concrete trim plaster roof rust_sheet firewall brick cornice 0.45 bands 1 loggias 0 balconies 0.15 shops 0.3 pitched 1 weight 1
style "Stucco tenement" role tenement floors_min 3 floors_max 5 ground 4.2 storey 3.5 bay 3.6 window_w 1.3 window_h 2 sill 0.9 depth_min 12 depth_max 14 width_min 16 width_max 30 wall plaster_yellow plinth concrete trim plaster roof rust_sheet firewall brick cornice 0.55 bands 1 loggias 0 balconies 0.2 shops 0.4 pitched 1 weight 1
style "Beige tenement" role tenement floors_min 4 floors_max 7 ground 4 storey 3.3 bay 3.3 window_w 1.3 window_h 1.8 sill 0.9 depth_min 12 depth_max 15 width_min 14 width_max 26 wall st_plaster_beige plinth concrete trim st_plaster_crack roof roof_tar firewall st_brick_worn cornice 0.4 bands 1 loggias 0 balconies 0.12 shops 0.25 pitched 0 weight 0.8
style "Dark brick tenement" role tenement floors_min 5 floors_max 8 ground 4 storey 3.2 bay 3.2 window_w 1.25 window_h 1.8 sill 0.9 depth_min 13 depth_max 15 width_min 14 width_max 24 wall st_brick_red plinth concrete trim plaster_peel roof roof_tar firewall brick cornice 0.35 bands 1 loggias 0 balconies 0.1 shops 0.2 pitched 0 weight 0.7
