# City kit "post-Soviet zone town" for the city generator (engine/CityGen.h, docs/CITY_GENERATOR.md).
# Edit in the editor: Tools > City generator > Kit. Paths are relative to this file. Sizes in metres, measured
# from the models (Kit tab > Measure). Frame of a building: length along X centred, street facade facing +Z at z = front.

material road "../materials/pbr/asphalt_02.material"
material pavement "../materials/pbr/concrete_pavement.material"
material yard "../materials/skrunda/terrain_lush.material"
material lot "../materials/skrunda/terrain_dirt.material"
material gate "../materials/pbr/rusty_painted_metal.material"
material pillar "../materials/pbr/red_brick.material"

# pre-war tenements of the overgrown street (zonegen/tenement.py): lengths in 3 m steps fill any frontage with gateways
building "House A" "../models/zone/street/house_a.glb" role tenement length 36 depth 14.4 front 7 floors 5 height 22.4 weight 1 lod "../models/zone/street/house_a_lod1.glb" 70 cull 600
building "House B" "../models/zone/street/house_b.glb" role tenement length 30 depth 14.4 front 7 floors 7 height 24.9 weight 1 lod "../models/zone/street/house_b_lod1.glb" 70 cull 600
building "House C" "../models/zone/street/house_c.glb" role tenement length 42 depth 14.4 front 7 floors 6 height 25.6 weight 1 lod "../models/zone/street/house_c_lod1.glb" 70 cull 600
