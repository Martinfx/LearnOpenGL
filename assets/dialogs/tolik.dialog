# Dialog (editor: Assets > Dialogs). The talk starts at the first node whose conditions hold.
speaker "@dialog.tolik.speaker"

node "fixed"
  if quest "tolik_radio" "report"
  text "@dialog.tolik.fixed"
  choice "@dialog.tolik.fixed.1" ""
    do complete_quest "tolik_radio"

node "waiting"
  if quest "tolik_radio" "find"
  text "@dialog.tolik.waiting"
  choice "@dialog.tolik.waiting.1" ""

node "start"
  text "@dialog.tolik.start"
  choice "@dialog.tolik.start.1" "radio"
  choice "@dialog.tolik.start.2" "boss"
  choice "@dialog.tolik.start.3" ""

node "radio"
  text "@dialog.tolik.radio"
  choice "@dialog.tolik.radio.1" "storm"
  choice "@dialog.tolik.radio.3" "job"
    if quest "tolik_radio" none
  choice "@dialog.tolik.radio.2" ""

node "storm"
  text "@dialog.tolik.storm"
  do set_flag "heard_about_storm"
  choice "@dialog.tolik.storm.1" ""

node "boss"
  text "@dialog.tolik.boss"
  choice "@dialog.tolik.boss.1" ""

node "job"
  text "@dialog.tolik.job"
  choice "@dialog.tolik.job.1" ""
    do start_quest "tolik_radio"
  choice "@dialog.tolik.job.2" ""
