# Dialog (editor: Assets > Dialogs). The talk starts at the first node whose conditions hold.
speaker "@dialog.grisha.speaker"

node "first"
  if not flag "met_grisha"
  text "@dialog.grisha.first"
  do set_flag "met_grisha"
  choice "@dialog.grisha.first.1" "work"
  choice "@dialog.grisha.first.2" ""
    do trade
  choice "@dialog.grisha.first.3" ""

node "found"
  if quest "camp_stash" "report"
  text "@dialog.grisha.found"
  choice "@dialog.grisha.found.1" ""
    do complete_quest "camp_stash"

node "waiting"
  if quest "camp_stash" "find"
  text "@dialog.grisha.waiting"
  choice "@dialog.grisha.waiting.1" ""

node "start"
  text "@dialog.grisha.start"
  choice "@dialog.grisha.start.1" "work"
    if quest "camp_stash" none
  choice "@dialog.grisha.start.2" "news"
  choice "@dialog.grisha.start.3" ""
    do trade
  choice "@dialog.grisha.start.4" ""

node "work"
  text "@dialog.grisha.work"
  choice "@dialog.grisha.work.1" ""
    if quest "camp_stash" none
    do start_quest "camp_stash"
  choice "@dialog.grisha.work.2" ""

node "news"
  text "@dialog.grisha.news"
  choice "@dialog.grisha.news.1" "start"
