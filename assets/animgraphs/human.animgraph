# Animation graph (editor: Animation editor). Clip names come from the character's glTF file.
# Human NPC (bandit, soldier, stalker, worker): the enemy script sets speed / crouch / sit / aim /
# aim_pitch / dead / grip (left hand on the gun, 0..1) and fires hit / shoot / reload. Footstep times are the heel strikes of each clip.
param "speed" float 0
param "crouch" bool 0
param "sit" bool 0
param "dead" bool 0
param "hit" trigger 0
param "aim" bool 0
param "aim_pitch" float 0
param "shoot" trigger 0
param "reload" trigger 0
param "grip" float 0
foot_max_adjust 0.45
ragdoll_on_death 1
ragdoll "Bip01 Pelvis" 0.13 0 12 20 15
ragdoll "Bip01 Spine2" 0.15 0 16 30 25
ragdoll "Bip01 Head" 0.11 0.2 5 40 45
ragdoll "Bip01 L UpperArm" 0.055 0 2.5 75 40
ragdoll "Bip01 L Forearm" 0.045 0 1.5 70 10
ragdoll "Bip01 R UpperArm" 0.055 0 2.5 75 40
ragdoll "Bip01 R Forearm" 0.045 0 1.5 70 10
ragdoll "Bip01 L Thigh" 0.075 0 8 50 15
ragdoll "Bip01 L Calf" 0.06 0 4 65 5
ragdoll "Bip01 L Foot" 0.05 0.16 1 25 10
ragdoll "Bip01 R Thigh" 0.075 0 8 50 15
ragdoll "Bip01 R Calf" 0.06 0 4 65 5
ragdoll "Bip01 R Foot" 0.05 0.16 1 25 10
ik foot "Left leg" "Bip01 L Thigh" "Bip01 L Calf" "Bip01 L Foot" 1 "" "" "" 0
ik foot "Right leg" "Bip01 R Thigh" "Bip01 R Calf" "Bip01 R Foot" 1 "" "" "" 0
ik hand "Left hand on gun" "Bip01 L UpperArm" "Bip01 L Forearm" "Bip01 L Hand" 1 "grip" "Bip01 R Hand" "Pistol_Aim_Neutral" 0
event "Walk_Loop" 0.622 "footstep"
event "Walk_Loop" 1.289 "footstep"
event "Jog_Fwd_Loop" 0.016 "footstep"
event "Jog_Fwd_Loop" 0.482 "footstep"
event "Sprint_Loop" 0 "footstep"
event "Sprint_Loop" 0.333 "footstep"
event "Crouch_Fwd_Loop" 0 "footstep"
event "Crouch_Fwd_Loop" 0.967 "footstep"
event "Pistol_Reload" 0.35 "mag_out"
event "Pistol_Reload" 1.1 "mag_in"

layer "Base" "" 1 ""
entry "Locomotion"
state "Locomotion" blend1d "speed" "" loop 1 speed 1 at 0 0
sample "Idle_Loop" 0 0 1
sample "Walk_Loop" 1.4 0 1
sample "Jog_Fwd_Loop" 4 0 1
sample "Sprint_Loop" 6.5 0 1
state "Crouch" blend1d "speed" "" loop 1 speed 1 at 0 130
sample "Crouch_Idle_Loop" 0 0 1
sample "Crouch_Fwd_Loop" 1.2 0 1
state "Sit" clip "" "" loop 1 speed 1 at -190 0
sample "Sitting_Idle_Loop" 0 0 1
state "Hit" clip "" "" loop 0 speed 1 at 190 0
sample "Hit_Chest" 0 0 1
state "Death" clip "" "" loop 0 speed 1 at 190 130
sample "Death01" 0 0 1
transition "*" "Death" 0.15 -1 dead
transition "Locomotion" "Crouch" 0.25 -1 crouch !dead
transition "Crouch" "Locomotion" 0.25 -1 !crouch
transition "Locomotion" "Sit" 0.4 -1 sit
transition "Sit" "Locomotion" 0.4 -1 !sit
transition "Locomotion" "Hit" 0.05 -1 hit !dead
transition "Crouch" "Hit" 0.05 -1 hit !dead
transition "Hit" "Locomotion" 0.2 0.85

layer "Upper body" "Bip01 Spine1" 1 ""
entry "Off"
state "Off" empty "" "" loop 1 speed 1 at 0 0
state "Aim" blend1d "aim_pitch" "" loop 1 speed 1 at 190 0
sample "Pistol_Aim_Down" -1 0 1
sample "Pistol_Aim_Neutral" 0 0 1
sample "Pistol_Aim_Up" 1 0 1
state "Shoot" clip "" "" loop 0 speed 1 at 380 0
sample "Pistol_Shoot" 0 0 1
state "Reload" clip "" "" loop 0 speed 1 at 190 130
sample "Pistol_Reload" 0 0 1
transition "*" "Off" 0.1 -1 dead
transition "Off" "Aim" 0.2 -1 aim !dead
transition "Aim" "Off" 0.25 -1 !aim
transition "Aim" "Shoot" 0.05 -1 shoot
transition "Shoot" "Aim" 0.1 0.9
transition "Aim" "Reload" 0.2 -1 reload
transition "Reload" "Aim" 0.2 0.95
