# Data: dialogy, úkoly, předměty, zbraně (v datech jako "@klíč")
dialog.grisha.speaker = Hřiša
dialog.grisha.first = Další, co přežil cestu po dálnici? Sedni si k ohni, tady tě nikdo střílet nebude. Já jsem Hřiša.
dialog.grisha.first.1 = Co se tu dá dělat?
dialog.grisha.first.2 = Prodáváš něco?
dialog.grisha.first.3 = Jen se ohřeju. Měj se.
dialog.grisha.found = No ne, ty jsi to fakt přinesl? I s obvazy? Tady máš za to náboje, ty se ti budou hodit víc než mně.
dialog.grisha.found.1 = Rádo se stalo.
dialog.grisha.waiting = Nemocnice je ve městě na východ odtud. Horní patro, oddělení na severní straně. Dej pozor na bandity u cihelny.
dialog.grisha.waiting.1 = Už jdu.
dialog.grisha.start = Zase ty. Co potřebuješ?
dialog.grisha.start.1 = Máš pro mě nějakou práci?
dialog.grisha.start.2 = Co je nového v Zóně?
dialog.grisha.start.3 = Ukaž, co máš na prodej.
dialog.grisha.start.4 = Nic, měj se.
dialog.grisha.work = Práce by byla. Před poslední bouří jsem schoval zásoby v nemocnici ve městě, horní patro. Pak mě odtamtud vyhnali bandité. Přines mi je a nebudeš litovat.
dialog.grisha.work.1 = Platí, dojdu tam.
dialog.grisha.work.2 = Teď ne.
dialog.grisha.news = Psi se zase drží severně od tábora a bandité se usadili u cihelny. A když uslyšíš sirénu, nehraj si na hrdinu a zalez pod střechu.
dialog.grisha.news.1 = Díky za radu.
dialog.tolik.speaker = Tolik
dialog.tolik.start = Hm? Jo, klidně se ohřej. Jen moc nemluv, poslouchám rádio.
dialog.tolik.start.1 = Co v tom rádiu dávají?
dialog.tolik.start.2 = Kdo tu velí?
dialog.tolik.start.3 = Nechám tě být.
dialog.tolik.radio = Šum, a občas někdo počítá čísla. Prý vojenský maják. Já ho poslouchám kvůli bouřím: když začne pištět, mám tak minutu, než se nebe zbarví do ruda.
dialog.tolik.radio.1 = Kvůli bouřím?
dialog.tolik.radio.2 = Zajímavé.
dialog.tolik.storm = Bouře přichází bez varování, jen siréna z města. Kdo je venku, toho to spálí zevnitř. Sklep, dům, vagon, cokoli se střechou. Psi to cítí dřív než my.
dialog.tolik.storm.1 = Budu si to pamatovat.
dialog.tolik.boss = Nikdo. Ale když chceš práci, zeptej se Hřiši. Ten vždycky něco potřebuje.
dialog.tolik.boss.1 = Díky.
quest.camp_stash.title = Zásoby z nemocnice
quest.camp_stash.description = Hřiša v táboře na seřaďovacím nádraží schoval před bouří zásoby v nemocnici ve městě. Pak ho od nich zahnali bandité.
quest.camp_stash.find = Najdi Hřišovu skrýš v nemocnici (horní patro, oddělení na severní straně)
quest.camp_stash.report = Přines zásoby Hřišovi do tábora
