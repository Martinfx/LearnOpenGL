quest.dead_city.title = Dead City
quest.dead_city.description = Na vlnách, kde se dřív ozýval jen šum, někdo opakuje: „Balík je u novinového stánku na Union Square, u pomníku.“ Kdo ho tam nechal, už si pro něj nepřišel.
quest.dead_city.square = Dojdi na Union Square k pomníku v centru města
quest.dead_city.square_done = Pomník padlým. Novinový stánek by měl být kousek odsud.
quest.dead_city.stash = Najdi balík u novinového stánku na Union Square
quest.dead_city.found = Našel jsi balík: náboje, lékárnička a peníze
quest.dead_city.start = V rádiu někdo mluví o balíku na Union Square v centru
level.zone_city.title = Dead City
level.zone_city.hint = Město zarůstá desítky let. Vejdi do něj od jihu (South Entrance) a dojdi po avenue na Union Square s pomníkem v centru.
level.overgrown_street.hint = Město je desítky let prázdné a ulice zarůstá. Projdi na sever k barikádě na jejím konci.
quest.ljocha.title = Ljocha
quest.ljocha.description = Na zdech ulice Počtovaja je pořád dokola totéž jméno: ЛЁХА. U ohně uprostřed ulice ještě hoří sud, ale nikdo u něj nesedí.
quest.ljocha.start = Uprostřed ulice hoří oheň. Někdo tu ještě nedávno byl.
quest.ljocha.camp = Dojdi k ohni uprostřed ulice
quest.ljocha.camp_done = Na bedně leží vzkaz: „Ljocha šel přes barikádu na severu, k domu na konci ulice. Vrátí se do setmění.“ Rádio hraje dál.
quest.ljocha.north = Najdi Ljochu u severní barikády
quest.ljocha.found = Ljocha se přes barikádu nedostal. V jeho PDA je poslední záznam: „Za autobusem je ticho. Moc velké ticho.“
