# Ambience set: looping layers and random sounds around the listener (paths relative to this file)
# layer "sound" volume [day night]
# random "sound" min_interval max_interval min_distance max_distance day_chance night_chance height duck
layer "../ambient/wind.sound" 0.55 1 1
layer "../ambient/zone_drone.sound" 0.25 0.6 1
layer "../ambient/birds.sound" 0.35 1 0
random "../ambient/metal_creak.sound" 12 35 20 90 0.8 1 3 0
random "../ambient/distant_gunfire.sound" 25 80 150 450 0.5 0.8 0 0.35
random "../ambient/dog_bark_far.sound" 30 90 150 500 0.4 0.8 0 0
random "../ambient/dog_whine_far.sound" 90 240 80 250 0.1 0.5 0 0
random "../ambient/crow.sound" 15 45 20 120 0.8 0.1 6 0
