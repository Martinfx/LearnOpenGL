# Sound: variations (one is picked at random per play) and playback settings
# Radio on an empty band: hiss, crackle and a beacon beeping its call sign (loop, heard up to ~14 m).
file "radio_beacon_loop.ogg"
volume 0.7
pitch 1 1
distance 1 14
rolloff 1.2
loop 1
stream 1
spatial 1
group ambient
max_instances 4
caption "@caption.radio_beacon"
