# Sound: variations (one is picked at random per play) and playback settings
# Close lightning strike: crack into a rolling rumble (real recordings, source/build_thunder.py).
file "thunder_near_1.ogg"
file "thunder_near_2.ogg"
file "thunder_near_3.ogg"
file "thunder_near_4.ogg"
volume 1
pitch 0.9 1.08
distance 50 3000
rolloff 1
loop 0
stream 0
spatial 0
group ambient
max_instances 2
caption "@caption.thunder"
