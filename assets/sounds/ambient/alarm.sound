# Sound: variations (one is picked at random per play) and playback settings
# Facility alarm: two-tone horn (loop, carries far). Usually starts disabled and is switched on by entity I/O.
file "alarm_loop.ogg"
volume 0.9
pitch 1 1
distance 3 45
rolloff 1
loop 1
stream 1
spatial 1
group ambient
max_instances 4
caption "@caption.alarm"
